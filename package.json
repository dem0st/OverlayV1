{
  "name": "overlayv1",
  "version": "1.0.0",
  "description": "Панель модератора для Twitch-оверлеев: картинки, видео, сайты, текст, TTS и прямое управление OBS",
  "keywords": [
    "twitch",
    "overlay",
    "obs",
    "moderator",
    "tts",
    "broadcast",
    "scene"
  ],
  "license": "MIT",
  "author": "dem0st",
  "repository": {
    "type": "git",
    "url": "https://github.com/dem0st/overlayv1.git"
  },
  "bugs": {
    "url": "https://github.com/dem0st/overlayv1/issues"
  },
  "homepage": "https://github.com/dem0st/overlayv1#readme",
  "engines": {
    "node": ">=18"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "obs-websocket-js": "^5.0.8",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "com.overlayv1.app",
    "productName": "OverlayV1",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OverlayV1"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "dem0st <stepanesamosov@yandex.ru>",
      "synopsis": "Панель модератора для Twitch-оверлеев"
    }
  }
}